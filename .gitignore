# Datos de partida. Quedan fuera del repositorio: el shapefile nacional de
# seccion censal pesa 105 MB, por encima del limite de GitHub. El README
# documenta que hay que descargar y donde colocarlo.
data/

# Bytecode y cachés de Python
__pycache__/
*.py[cod]

# Entornos virtuales locales
.venv/
venv/

# Checkpoints de Jupyter
.ipynb_checkpoints/

# Configuracion local de Streamlit. `config.toml` si se versiona: fija el tema
# claro de la aplicacion. `secrets.toml` no, porque contendria credenciales.
.streamlit/secrets.toml

# Configuracion local de Claude Code. `launch.json` guarda la ruta absoluta del
# interprete de esta maquina y no significa nada en otra.
.claude/
